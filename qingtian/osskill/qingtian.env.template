# 擎天底座 Agent 环境变量
# 复制到 ~/.openclaw/workspace/agents/<agent-name>/qingtian.env
# 权限: chmod 600 qingtian.env

# ── 底座连接 ──────────────────────────────
export QINGTIAN_HOST="http://localhost:1996"
export QINGTIAN_TOKEN="yh_at_xxxxxxxx"

# ── Agent 身份 ────────────────────────────
export AGENT_ID="mgmt:main"               # 永恒命名空间（域:agent标识）
export AGENT_NAME="擎天中枢Agent"           # 显示名称
export AGENT_CATEGORY="internal"           # 类别: buyer/supplier/internal
export AGENT_CAPABILITIES='["管理","调度","审计"]'
export AGENT_SERVER="management-server"

# ── 记忆偏好 ──────────────────────────────
export QINGTIAN_MEM_TYPE="episodic"        # 默认记忆类型
export QINGTIAN_TOP_K="5"                  # 搜索/浮现返回条数

# ── 崩溃恢复 ──────────────────────────────
export QINGTIAN_RECOVER_SINCE=""           # ISO时间，留空=恢复全部

# ── HTTP 调优 ─────────────────────────────
export QINGTIAN_TIMEOUT="30"               # 请求超时秒数
export QINGTIAN_MAX_RETRIES="3"            # 最大重试次数
